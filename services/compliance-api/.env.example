# Copy to .env and adjust values before running the API locally.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/compliance
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used by apps/compliance-web for server-side API requests (not read by this service).
API_BASE_URL=http://localhost:8000

# Vision parsing (corridor width callouts from drawing page images)
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o-mini

# Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
