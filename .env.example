# Copy to .env and adjust values before running: docker compose up --build

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compliance

# compliance-api
# Use the postgres service hostname (not localhost) inside Docker Compose.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/compliance
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# compliance-web
# Internal Docker network URL for server-side requests to the API.
API_BASE_URL=http://compliance-api:8000

# compliance-api vision parsing
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o-mini

# Claude (Anthropic Messages API)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
